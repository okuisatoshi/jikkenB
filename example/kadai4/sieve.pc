int main() {
    int n; int i;
    n = 10000;
    int xs[10000];
    i = 2;
    while (i < n) {
        xs[i] = 1;
        i = i + 1;
    }
    i = 2;
    while (i < n) {
        if (xs[i]) {
            print i;
            xs[i] = 0;
            int k;
            k = i * i;
            while (k < n) {
                xs[k] = 0;
                k = k + i;
            }
        }
        i = i + 1;
    }
}

