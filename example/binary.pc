int main() {
    int x; int n; int m;
    x = 2; n = 1234567890; m = 1234;

    int a;
    a = 1;
    while (n > 0) {
        // if (n % 2) a = a * x % m;をwhile文でシミュレート
        int c; c = n % 2;
        while (c) {
            a = a * x % m;
            c = 0;
        }
        x = x * x % m;
        n = n / 2;
    }
    print a;
}
